<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>DotNetBridge</AssemblyName>
    <RootNamespace>NativeScriptBridge</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <!-- Regular class library — hostfxr loads it at runtime; no NativeAOT needed. -->
    <OutputType>Library</OutputType>
    <!-- Required: dotnet publish on a class library won't emit runtimeconfig.json by default. -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <!-- Allow hostfxr to load this assembly under net10+ without a re-publish.
         Default (Minor) only accepts patch updates within major 9, which fails when the
         host process is already running on net10. LatestMajor accepts any version >= 9. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <!-- The bridge only runs inside a Windows host, but the TFM stays plain net9.0 so the
         net9.0 test/benchmark projects can reference it. Declaring the platform here keeps
         CA1416 quiet for the Marshal COM APIs. Skipped when an OS-specific TFM already emits it. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute" Condition="'$(TargetPlatformIdentifier)' == ''">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="WriteDotNetToolDone" AfterTargets="Publish">
    <PropertyGroup>
      <DotNetToolDoneFile>$(MSBuildProjectDirectory)\publish\.dotnet_tool_done</DotNetToolDoneFile>
    </PropertyGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\publish" Condition="!Exists('$(MSBuildProjectDirectory)\publish')" />
    <!-- Copy published output to the local publish/ staging directory that tns deploys from -->
    <Copy SourceFiles="$(PublishDir)DotNetBridge.dll" DestinationFolder="$(MSBuildProjectDirectory)\publish" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(PublishDir)DotNetBridge.pdb" DestinationFolder="$(MSBuildProjectDirectory)\publish" SkipUnchangedFiles="false" Condition="Exists('$(PublishDir)DotNetBridge.pdb')" />
    <Copy SourceFiles="$(PublishDir)DotNetBridge.runtimeconfig.json" DestinationFolder="$(MSBuildProjectDirectory)\publish" SkipUnchangedFiles="false" Condition="Exists('$(PublishDir)DotNetBridge.runtimeconfig.json')" />
    <WriteLinesToFile File="$(DotNetToolDoneFile)" Lines="done" Overwrite="true" />
  </Target>
</Project>
