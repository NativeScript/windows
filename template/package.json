{
  "name": "@nativescript/windows",
  "version": "1.0.0-beta.8",
  "description": "NativeScript Windows runtime with a WinUI 3 app template",
  "repository": {
        "type": "git",
        "url": "https://github.com/NativeScript/windows.git"
  },
  "scripts": {
    "build": "pwsh -File build.ps1",
    "build:x64": "pwsh -File build.ps1 -SkipArm64",
    "build:nodotnet": "pwsh -File build.ps1 -SkipDotnet"
  },
  "keywords": ["nativescript", "windows", "winrt", "winui3", "windows-app-sdk"],
  "license": "Apache-2.0",
  "files": [
    "framework/**/*",
    "!framework/**/bin/**",
    "!framework/**/obj/**"
  ],
  "nativescript": {
    "runtime": "windows",
    "engine": "v8"
  }
}
